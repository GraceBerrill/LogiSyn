<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      THEME - fonts, colours and reusable styles for the whole app.
      Order matters: a StaticResource has to be defined ABOVE the place it is used.
      Icons.xaml must be merged BEFORE this file (see App.xaml).
    -->

    <!-- ===== Fonts (files live in LogiSyn/Fonts, Build Action = Resource) ===== -->
    <FontFamily x:Key="FontMS">Segoe UI</FontFamily>
    <FontFamily x:Key="FontVarela">Segoe UI</FontFamily>
    <FontFamily x:Key="FontLexend">Segoe UI</FontFamily>

    <!-- ===== Colours (from Figma) ===== -->
    <SolidColorBrush x:Key="Navy" Color="#122441"/>
    <SolidColorBrush x:Key="NavyMuted" Color="#8F122441"/>
    <SolidColorBrush x:Key="NavyPlaceholder" Color="#7A122441"/>
    <SolidColorBrush x:Key="PageBg" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="SidebarInactive" Color="#8992A0"/>
    <SolidColorBrush x:Key="LinkBlue" Color="#5281CF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#66122441"/>
    <SolidColorBrush x:Key="RuleBrush" Color="#80122441"/>
    <SolidColorBrush x:Key="GreenAction" Color="#135826"/>
    <SolidColorBrush x:Key="PaperMuted" Color="#75000000"/>
    <SolidColorBrush x:Key="PaperRule" Color="#66000000"/>
    <SolidColorBrush x:Key="CompletedGreen" Color="#148C45"/>

    <!-- Pop-up backdrops -->
    <SolidColorBrush x:Key="ScrimDetail" Color="#A1FFFFFF"/>
    <SolidColorBrush x:Key="ScrimPrint" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="ScrimDone" Color="#9CFFFFFF"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="3" ShadowDepth="1.5" Direction="270"
                      Opacity="0.3" Color="Black"/>
    <DropShadowEffect x:Key="NavShadow" BlurRadius="3" ShadowDepth="1.5" Direction="270"
                      Opacity="0.45" Color="Black"/>

    <!-- ===== Text styles ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="42.7"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
    </Style>

    <!-- PrimaryButton kept for backward compatibility with some views -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Navy}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMS}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="59.3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13"
                                Effect="{StaticResource CardShadow}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PageDate" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource NavyMuted}"/>
    </Style>
    <!-- Big table: grey column heading + normal cell text -->
    <Style x:Key="HeadText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26.7"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource NavyMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26.7"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Manage Products table (smaller) -->
    <Style x:Key="HeadTextSmall" TargetType="TextBlock" BasedOn="{StaticResource HeadText}">
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="CellTextSmall" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
        <Setter Property="FontSize" Value="21.3"/>
    </Style>
    <!-- Text on the white "paper" sheets -->
    <Style x:Key="PaperText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontVarela}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style x:Key="PaperLabel" TargetType="TextBlock" BasedOn="{StaticResource PaperText}">
        <Setter Property="Foreground" Value="{StaticResource PaperMuted}"/>
    </Style>

    <!-- ===== Cards: white, thin border, soft shadow on its own layer so text stays sharp ===== -->
    <Style x:Key="Card28" TargetType="ContentControl">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="28" Effect="{StaticResource CardShadow}"/>
                        <ContentPresenter/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Card16" TargetType="ContentControl">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="16" Effect="{StaticResource CardShadow}"/>
                        <ContentPresenter/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Card13" TargetType="ContentControl">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="13" Effect="{StaticResource CardShadow}"/>
                        <ContentPresenter/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Table row line ===== -->
    <Style x:Key="RowLine" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- ===== Buttons ===== -->

    <!-- Navy pill-ish button: Create New Order, GO, DONE, ADD, PRINT ... -->
    <Style x:Key="NavyButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Navy}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMS}"/>
        <Setter Property="FontSize" Value="21.3"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Height" Value="59.3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13"
                                Effect="{StaticResource CardShadow}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource NavyButton}">
        <Setter Property="Background" Value="{StaticResource GreenAction}"/>
    </Style>

    <!-- White button with a thin border: Excel, Email, Link To Orders, Browse Files -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMS}"/>
        <Setter Property="FontSize" Value="21.3"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Height" Value="47.3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="13" Effect="{StaticResource CardShadow}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Blue underlined "VIEW" link -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource LinkBlue}"/>
        <Setter Property="FontSize" Value="26.7"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" TextDecorations="Underline"
                               Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Opacity" Value="0.65"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent button that just holds an icon (edit, bin, X, log out) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round navy back arrow -->
    <Style x:Key="BackButton" TargetType="Button">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Ellipse Fill="{StaticResource Navy}"/>
                        <Image Source="{StaticResource IconBack}" Width="30" Height="30"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar item (the ShellWindow swaps the background when it is the active page) -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SidebarInactive}"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMS}"/>
        <Setter Property="FontSize" Value="21.3"/>
        <Setter Property="Height" Value="51"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Effect="{StaticResource NavShadow}"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A whole clickable row card (User - Orders list) -->
    <Style x:Key="RowCardButton" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Height" Value="68.3"/>
        <Setter Property="Margin" Value="0,0,0,20.4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="10" Effect="{StaticResource CardShadow}"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Search box: magnifier + placeholder text (put the placeholder in Tag) ===== -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Height" Value="72"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMS}"/>
        <Setter Property="FontSize" Value="21.3"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="15" Effect="{StaticResource CardShadow}"/>
                        <Image Source="{StaticResource IconSearch}" Width="34" Height="34"
                               HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="54,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Margin="56,0,16,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{StaticResource NavyPlaceholder}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Filter drop-down (All Statuses / DATE / Storage) ===== -->
    <Style x:Key="FilterItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontMS}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E9EEF6"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE4F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="72"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMS}"/>
        <Setter Property="FontSize" Value="21.3"/>
        <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FilterItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border Background="White" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="15" Effect="{StaticResource CardShadow}"/>
                        <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="18,0,64,0" VerticalAlignment="Center"
                                          HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <Image Source="{StaticResource IconArrowDown}" Width="32" Height="32"
                               HorizontalAlignment="Right" Margin="0,0,18,0" IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="300" Margin="0,6,10,12" Background="White"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10"
                                    Effect="{StaticResource CardShadow}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Plain text box used inside sheet cells / forms ===== -->
    <Style x:Key="CellTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontVarela}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== Navy panel with a white page and a thin white scroll thumb (the "paper" viewer) ===== -->
    <Style x:Key="PaperThumbRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PaperThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="White" CornerRadius="7.5" MinHeight="50"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PaperScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource PaperThumbRepeat}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource PaperThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource PaperThumbRepeat}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PaperPanel" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Border Background="{StaticResource Navy}" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="17,17,0,17" Background="White" ClipToBounds="True">
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            </Border>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="14,17,13,17"
                                       Style="{StaticResource PaperScrollBar}"
                                       Orientation="Vertical"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>