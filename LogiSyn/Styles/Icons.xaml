<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ICONS - export each one from Figma as PNG (2x), save it in  LogiSyn/Assets/Icons/  with the
      file name shown, and set Build Action = Resource.
      To find an icon: open the link, the layer is selected, then use Export at the bottom of the right panel.
      Base link: https://www.figma.com/design/4SQyq5L1KBVQ2y2uraDBlo/XBCAD-UX?node-id=

        user.png        ...node-id=1-83      (login: user icon)
        eye-off.png     ...node-id=1-412     (login: eye icon)
        avatar.png      ...node-id=1-214     (sidebar: user icon in the round avatar)
        dashboard.png   ...node-id=1-118     (sidebar: Dashboard)
        list.png        ...node-id=1-123     (sidebar: Orders / View History)
        history.png     ...node-id=19-147    (sidebar: History)
        products.png    ...node-id=20-1553   (sidebar: Manage Products)
        users.png       ...node-id=1-182     (sidebar: Manage Users)
        logout.png      ...node-id=76-158    (sidebar: Log Out arrow)
        search.png      ...node-id=1-237     (magnifier)
        arrow-down.png  ...node-id=1-239     (dropdown triangle)
        excel.png       ...node-id=19-293    (dashboard: Excel)
        email.png       ...node-id=1-138     (dashboard: Email)
        upload.png      ...node-id=1-279     (create order: upload)
        edit.png        ...node-id=110-695   (pencil)
        trash.png       ...node-id=110-696   (bin)
        close.png       ...node-id=20-1908   (X on product pop-up)
        back.png        ...node-id=19-389    (round back arrow)
        add.png         ...node-id=1-613     (plus on Add Users)
        check.png       ...node-id=20-2541   (tick on the completed pop-up)
    -->

    <BitmapImage x:Key="IconUser"      UriSource="/Assets/Icons/user.png"/>
    <BitmapImage x:Key="IconEyeOff"    UriSource="/Assets/Icons/eye-off.png"/>
    <BitmapImage x:Key="IconAvatar"    UriSource="/Assets/Icons/avatar.png"/>
    <BitmapImage x:Key="IconDashboard" UriSource="/Assets/Icons/dashboard.png"/>
    <BitmapImage x:Key="IconList"      UriSource="/Assets/Icons/list.png"/>
    <BitmapImage x:Key="IconHistory"   UriSource="/Assets/Icons/history.png"/>
    <BitmapImage x:Key="IconProducts"  UriSource="/Assets/Icons/products.png"/>
    <BitmapImage x:Key="IconUsers"     UriSource="/Assets/Icons/users.png"/>
    <BitmapImage x:Key="IconLogout"    UriSource="/Assets/Icons/logout.png"/>
    <BitmapImage x:Key="IconSearch"    UriSource="/Assets/Icons/search.png"/>
    <BitmapImage x:Key="IconArrowDown" UriSource="/Assets/Icons/arrow-down.png"/>
    <BitmapImage x:Key="IconExcel"     UriSource="/Assets/Icons/excel.png"/>
    <BitmapImage x:Key="IconEmail"     UriSource="/Assets/Icons/email.png"/>
    <BitmapImage x:Key="IconUpload"    UriSource="/Assets/Icons/upload.png"/>
    <BitmapImage x:Key="IconEdit"      UriSource="/Assets/Icons/edit.png"/>
    <BitmapImage x:Key="IconTrash"     UriSource="/Assets/Icons/trash.png"/>
    <BitmapImage x:Key="IconClose"     UriSource="/Assets/Icons/close.png"/>
    <BitmapImage x:Key="IconBack"      UriSource="/Assets/Icons/back.png"/>
    <BitmapImage x:Key="IconAdd"       UriSource="/Assets/Icons/add.png"/>
    <BitmapImage x:Key="IconCheck"     UriSource="/Assets/Icons/check.png"/>

</ResourceDictionary>