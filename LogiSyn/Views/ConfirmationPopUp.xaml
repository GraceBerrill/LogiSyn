<Window x:Class="LogiSyn.Views.ConfirmationPopUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Order Completed"
        Height="540" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid Margin="20">
        <!-- White Rounded Dialog Card -->
        <Border Background="White"
                CornerRadius="32"
                BorderBrush="#152238"
                BorderThickness="1.5"
                Padding="30,45">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" 
                                  ShadowDepth="5" 
                                  Direction="270" 
                                  Color="#30000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Checkmark Area -->
                    <RowDefinition Height="*"/>
                    <!-- Action Button Area -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Navy Circle with Vector Checkmark -->
                <Border Grid.Row="0"
                        Width="200" Height="200"
                        CornerRadius="100"
                        Background="#152238"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <!-- Vector Path for precision checkmark geometry -->
                    <Path Data="M 16,50 L 40,76 L 86,22" 
                          Stroke="White" 
                          StrokeThickness="11" 
                          StrokeStartLineCap="Round" 
                          StrokeEndLineCap="Round" 
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center"
                          Margin="0,0,4,0"/>
                </Border>

                <!-- 2. DONE Action Button -->
                <Button Grid.Row="1"
                        Content="DONE"
                        Height="60"
                        Width="280"
                        Background="#152238"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="Bold"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        Click="BtnDone_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
