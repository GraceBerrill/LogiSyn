<UserControl x:Class="LogiSyn.Views.ExportOrdersModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="820" MaxHeight="680"
             FontFamily="{StaticResource FontMS}">

    <Border Background="White" BorderBrush="{StaticResource Navy}" BorderThickness="1.5"
            CornerRadius="20" Effect="{StaticResource CardShadow}" Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header & Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Export Orders to Excel" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource Navy}"/>
                    <TextBlock Text="Choose the order(s) to export. Complete production sheets with products, packaging, ingredients, and raw material scaling will be generated."
                               FontSize="13" Foreground="{StaticResource NavyMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="#F1F4F9" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="17"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Navy}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Row 1: Selection Controls Toolbar -->
            <Border Grid.Row="1" Background="#F4F6FA" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="SelectAllBox" Content="Select All" FontWeight="SemiBold"
                                  FontSize="14" Foreground="{StaticResource Navy}"
                                  VerticalContentAlignment="Center" Click="SelectAllBox_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SelectedCountText" Text="0 of 0 orders selected"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource NavyMuted}"/>
                </Grid>
            </Border>

            <!-- Row 2: Scrollable Orders List -->
            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                    Background="#FAFBFD" MinHeight="180" MaxHeight="270" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="OrdersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10"
                                        Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Row_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Click="ItemCheckBox_Click"/>

                                        <!-- Order ID -->
                                        <TextBlock Grid.Column="1" Text="{Binding Number}" FontWeight="Bold"
                                                   FontSize="15" Foreground="{StaticResource Navy}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Customer -->
                                        <TextBlock Grid.Column="2" Text="{Binding Customer}" FontWeight="SemiBold"
                                                   FontSize="14" Foreground="{StaticResource Navy}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Date -->
                                        <TextBlock Grid.Column="3" Text="{Binding DateText}" FontSize="13"
                                                   Foreground="{StaticResource NavyMuted}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="4" Background="{Binding StatusBgBrush}" CornerRadius="12"
                                                Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- Items Summary -->
                                        <TextBlock Grid.Column="5" Text="{Binding ItemsSummary}" FontSize="12.5"
                                                   Foreground="#4A5568" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Row 3: Export Format Options -->
            <StackPanel Grid.Row="3" Margin="4,0,0,16">
                <TextBlock Text="Export Format (for multiple orders):" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Navy}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbCombined" Content="Single Combined Workbook (Overview sheet + dedicated tab for each order)"
                                 IsChecked="True" FontSize="13" Foreground="{StaticResource Navy}" Margin="0,0,24,0"/>
                    <RadioButton x:Name="RbSeparate" Content="Separate Files (Folder with individual .xlsx files)"
                                 FontSize="13" Foreground="{StaticResource Navy}"/>
                </StackPanel>
            </StackPanel>

            <!-- Row 4: Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="120" Height="44"
                        Margin="0,0,14,0" Click="CloseButton_Click"/>
                <Button x:Name="ExportButton" Content="Export to Excel" Style="{StaticResource PrimaryButton}"
                        Width="210" Height="44" FontSize="16" Click="ExportButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

