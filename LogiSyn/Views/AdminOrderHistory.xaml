<Page x:Class="LogiSyn.Views.AdminOrderHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="History"
      d:DesignHeight="800" d:DesignWidth="940"
      Background="#F5F6FA"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

<Page.Resources>
    <!-- DataGrid Row Style -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#EAEBF0"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="FontSize" Value="18"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F8FAFC"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Column Header Style -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8A92A6"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,10"/>
    </Style>

    <!-- VIEW Text/Link Button -->
    <Style x:Key="ViewLinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#3B82F6"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}" 
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline"
                                   VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</Page.Resources>

<Grid Margin="45,35,45,35">
    <Grid.RowDefinitions>
        <!-- Title -->
        <RowDefinition Height="Auto"/>
        <!-- Search & Filters -->
        <RowDefinition Height="Auto"/>
        <!-- Table Card -->
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 1. Header -->
    <StackPanel Grid.Row="0" VerticalAlignment="Center">
        <TextBlock Text="History" FontSize="34" FontWeight="Bold" Foreground="#1B2136"/>
        <TextBlock x:Name="TxtCurrentDate" Text="10/08/2026" FontSize="13" Foreground="#8A92A6" Margin="2,4,0,0"/>
    </StackPanel>

    <!-- 2. Search & Filter Bar -->
    <Grid Grid.Row="1" Margin="0,25,0,25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Search Bar -->
        <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="14" 
                    Height="52"
                    BorderBrush="#CFD6E4" 
                    BorderThickness="1"
                    Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                               Text="&#xE721;" 
                               FontFamily="Segoe MDL2 Assets" 
                               FontSize="18" 
                               Foreground="#8A92A6" 
                               VerticalAlignment="Center" 
                               Margin="0,0,12,0"/>

                <TextBox x:Name="TxtSearchBox" 
                             Grid.Column="1" 
                             BorderThickness="0" 
                             Background="Transparent" 
                             FontSize="16" 
                             VerticalContentAlignment="Center" 
                             Foreground="#1B2136"
                             TextChanged="TxtSearchBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- Date Filter Dropdown -->
        <Border Grid.Column="2" 
                    Background="White" 
                    CornerRadius="14" 
                    Height="52"
                    BorderBrush="#CFD6E4" 
                    BorderThickness="1"
                    Padding="15,0">
            <ComboBox x:Name="CmbDateSort" 
                          BorderThickness="0" 
                          Background="Transparent" 
                          FontSize="16" 
                          FontWeight="Bold"
                          Foreground="#1B2136"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0"
                          SelectionChanged="CmbDateSort_SelectionChanged">
                <ComboBoxItem Content="DATE"/>
                <ComboBoxItem Content="Newest First"/>
                <ComboBoxItem Content="Oldest First"/>
            </ComboBox>
        </Border>
    </Grid>

    <!-- 3. Table Card -->
    <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="24" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1"
                Padding="30,20">
        <DataGrid x:Name="HistoryDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="Transparent">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order" 
                                        Binding="{Binding OrderId}" 
                                        Width="1.2*" 
                                        FontWeight="SemiBold" 
                                        Foreground="#1B2136"/>

                <DataGridTextColumn Header="Customer" 
                                        Binding="{Binding Customer}" 
                                        Width="2*" 
                                        Foreground="#1B2136"/>

                <DataGridTextColumn Header="Date Completed" 
                                        Binding="{Binding OrderDate, StringFormat=\{0:dd/MM/yy\}}" 
                                        Width="2*" 
                                        Foreground="#1B2136"/>

                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="VIEW" 
                                        Style="{StaticResource ViewLinkButtonStyle}"
                                        Click="BtnView_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</Grid>
</Page>