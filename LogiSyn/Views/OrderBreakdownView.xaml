<!-- Adriaan -->
<UserControl x:Class="LogiSyn.Views.OrderBreakdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- History > VIEW: one finished order.
         Admin sees the short summary, Manager sees the full sheet with what was used.
         (No sidebar on this page - the ShellWindow hides it.) -->
    <Grid Margin="19,0,44,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="43"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Order Breakdown" Style="{StaticResource PageTitle}"
                   VerticalAlignment="Top" Margin="0,24.3,0,0"/>

        <!-- the paper is put in here from the code-behind -->
        <ScrollViewer x:Name="PaperHost" Grid.Row="1" Style="{StaticResource PaperPanel}"
                      Width="655.7" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="1" Width="322.7" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <!-- Adriaan - Email updated Excel back to admin -->
            <Button x:Name="EmailButton" Content="EMAIL EXCEL" Style="{StaticResource NavyButton}"
                    Height="52" Margin="0,0,0,16" Click="EmailButton_Click"/>
            <Button x:Name="DoneButton" Content="DONE" Style="{StaticResource NavyButton}"
                    Height="52" Click="DoneButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>