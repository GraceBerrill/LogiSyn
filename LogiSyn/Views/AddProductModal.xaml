<UserControl x:Class="LogiSyn.Views.AddProductModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="520"
             MinHeight="400"
             MaxHeight="700">

    <Border Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Add Product"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Add a product to this order."
                           Style="{StaticResource PageDate}"/>
            </StackPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,24">

                <StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Product Name"
                                   Style="{StaticResource HeadTextSmall}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ProductBox"
                                 Style="{StaticResource SearchBox}"
                                 Height="40"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Amount"
                                   Style="{StaticResource HeadTextSmall}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ProductAmountBox"
                                 Style="{StaticResource SearchBox}"
                                 Height="40"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Production"
                                   Style="{StaticResource HeadTextSmall}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ProductionBox"
                                 Style="{StaticResource SearchBox}"
                                 Height="40"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Ingredients"
                                   Style="{StaticResource HeadTextSmall}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="IngredientBox"
                                 Style="{StaticResource SearchBox}"
                                 Height="90"
                                 Padding="12"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Packaging Used"
                                   Style="{StaticResource HeadTextSmall}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="PackagingUsedBox"
                                 Style="{StaticResource SearchBox}"
                                 Height="70"
                                 Padding="12"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Add"
                        x:Name="AddButton"
                        Click="AddButton_Click"
                        Style="{StaticResource IconButton}"
                        Padding="18,10" Height="45" Width="461"/>

            </StackPanel>
        </Grid>

    </Border>

</UserControl>