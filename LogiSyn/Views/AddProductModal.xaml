<UserControl x:Class="LogiSyn.Views.AddProductModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="760" Height="420">

    <Grid>
        <Border Background="White" BorderBrush="#99000000" BorderThickness="1" CornerRadius="20" Padding="20">
            <StackPanel>
                <TextBlock Text="Add Product" FontSize="28" FontWeight="Bold" Margin="0,0,0,12"/>

                <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                    <TextBlock Text="Product name"/>
                    <TextBox x:Name="ProductBox" Width="500" Height="36" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Left">
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Price"/>
                        <TextBox x:Name="ProductPriceBox" Width="160" Height="36" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Sell By"/>
                        <TextBox x:Name="SellByBox" Width="120" Height="36" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,0,12,0">
                        <TextBlock Text="Best Before"/>
                        <TextBox x:Name="BestBeforeBox" Width="120" Height="36" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Storage"/>
                        <ComboBox x:Name="StorageBox" Width="140" Height="36">
                            <ComboBoxItem Content="Freezer"/>
                            <ComboBoxItem Content="Fridge"/>
                            <ComboBoxItem Content="Dry Store"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Add" Width="160" Height="46" Click="AddButton_Click" Style="{StaticResource NavyButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
