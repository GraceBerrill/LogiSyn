<Window x:Class="LogiSyn.Views.AddMoreProducts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LogiSyn.Views"
        Title="Adding New Product"
        Height="560" Width="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- Outer Window Border -->
    <Border BorderBrush="#1B2136" BorderThickness="1" Background="White" Padding="35,28,35,32">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Title Header -->
                <RowDefinition Height="Auto"/>
                <!-- Main Content Area -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Page Title -->
            <TextBlock Grid.Row="0" 
                       Text="Adding New Product" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="#0F2038" 
                       Margin="0,0,0,18"/>

            <!-- 2. Main Body Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Form Box -->
                    <ColumnDefinition Width="3.2*"/>
                    <!-- Right Area with ADD button -->
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Bordered Table Container -->
                <Border Grid.Column="0" 
                        BorderBrush="#555555" 
                        BorderThickness="1" 
                        Background="White"
                        Padding="14,12,14,14">
                    <Grid>
                        <!-- 4 Synchronized Columns for all 3 rows -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="2.3*"/>
                            <ColumnDefinition Width="2.0*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <!-- Row 1: Product -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                            <!-- Row 2: Ingredients -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                            <!-- Row 3: Packaging -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                            <!-- Whitespace Filler -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ================= ROW 1: PRODUCT ================= -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Product" FontSize="18" Foreground="#6B7280" Margin="4,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Amount" FontSize="18" Foreground="#6B7280" Margin="6,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="Production" FontSize="18" Foreground="#6B7280" Margin="6,0,0,6"/>

                        <!-- Row 1 Table Box -->
                        <Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="#555555" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="4.3*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtProduct" Grid.Column="0" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"/>
                                <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,1,0"/>

                                <TextBox x:Name="TxtProductAmount" Grid.Column="1" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" local:IntegerInputLimiter.IsEnabled="True"/>
                                <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,1,0"/>

                                <TextBox x:Name="TxtProduction" Grid.Column="2" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"/>
                            </Grid>
                        </Border>

                        <!-- ================= ROW 2: INGREDIENTS ================= -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ingredients" FontSize="18" Foreground="#6B7280" Margin="4,20,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Amount" FontSize="18" Foreground="#6B7280" Margin="6,20,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Additional" FontSize="18" Foreground="#6B7280" Margin="6,20,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Used" FontSize="18" Foreground="#6B7280" Margin="6,20,0,6"/>

                        <!-- Row 2 Table Box -->
                        <Border Grid.Row="3" Grid.ColumnSpan="4" BorderBrush="#555555" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="2.3*"/>
                                    <ColumnDefinition Width="2.0*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtIngredientName" Grid.Column="0" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"/>
                                <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,1,0"/>

                                <TextBox x:Name="TxtIngredientAmount" Grid.Column="1" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" local:DoubleInputLimiter.IsEnabled="True"/>
                                <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,1,0"/>

                                <TextBox x:Name="TxtIngredientAdditional" Grid.Column="2" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" local:DoubleInputLimiter.IsEnabled="True"/>
                                <Border Grid.Column="2" BorderBrush="#555555" BorderThickness="0,0,1,0"/>

                                <TextBox x:Name="TxtIngredientUsed" Grid.Column="3" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" local:DoubleInputLimiter.IsEnabled="True"/>
                            </Grid>
                        </Border>

                        <!-- ================= ROW 3: PACKAGING ================= -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Packaging" FontSize="18" Foreground="#6B7280" Margin="4,20,0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Amount" FontSize="18" Foreground="#6B7280" Margin="6,20,0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Used" FontSize="18" Foreground="#6B7280" Margin="6,20,0,6"/>

                        <!-- Row 3 Table Box -->
                        <Border Grid.Row="5" Grid.ColumnSpan="4" BorderBrush="#555555" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="2.3*"/>
                                    <ColumnDefinition Width="2.0*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtPackagingType" Grid.Column="0" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"/>
                                <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="0,0,1,0"/>

                                <TextBox x:Name="TxtPackagingAmount" Grid.Column="1" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" local:DoubleInputLimiter.IsEnabled="True"/>
                                <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="0,0,1,0"/>

                                <TextBox x:Name="TxtPackagingUsed" Grid.Column="2" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0" local:DoubleInputLimiter.IsEnabled="True"/>
                                <Border Grid.Column="2" BorderBrush="#555555" BorderThickness="0,0,1,0"/>

                                <!-- Unused 4th cell matching screenshot -->
                                <Border Grid.Column="3" Background="Transparent"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. ADD Action Button -->
                <Button Grid.Column="1" 
                        Content="ADD" 
                        Width="180" 
                        Height="58"
                        Background="#0F2038" 
                        Foreground="White" 
                        FontSize="22" 
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Click="BtnAdd_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Color="#40000000"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
