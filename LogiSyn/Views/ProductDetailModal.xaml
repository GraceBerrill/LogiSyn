<UserControl x:Class="LogiSyn.Views.ProductDetailModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogiSyn.Views"
             Width="620"
             FontFamily="{StaticResource FontMS}" Foreground="Black">

    <!-- Product pop-up (Manage Products > VIEW or the edit pencil). DataContext = ProductDetail -->
    <UserControl.Resources>
        <!-- text boxes that look like plain text until the pop-up is opened for editing -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource CellTextBox}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMS}"/>
            <Setter Property="IsReadOnly"
                    Value="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type local:ProductDetailModal}}}"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#333333" BorderThickness="1">
        <Grid Margin="24,20,24,24">
            <!-- X in the top right corner -->
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                    Click="CloseButton_Click" Cursor="Hand" Focusable="False">
                <Path Data="{StaticResource IconCloseGeometry}" Style="{StaticResource IconPath}"
                      Stroke="{StaticResource Navy}" Width="16" Height="16"/>
            </Button>

            <StackPanel Margin="0,0,0,0">
                <!-- Title & Date Added -->
                <TextBox Text="{Binding Name, Mode=TwoWay}" Style="{StaticResource FieldBox}"
                         FontSize="34" FontWeight="Bold" Foreground="{StaticResource Navy}"
                         Margin="0,0,36,0" Padding="0"/>

                <TextBlock x:Name="DateAddedText" FontSize="15" Foreground="#666666" Margin="0,4,0,18"/>

                <!-- Ingredient List Per Quantity -->
                <TextBlock Text="Ingredient List Per Quantity" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Navy}" Margin="0,6,0,6"/>
                <Border BorderBrush="#444444" BorderThickness="0,1,0,0">
                    <ItemsControl ItemsSource="{Binding Ingredients}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Height="38">
                                    <Grid Margin="2,0,2,0">
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" Style="{StaticResource FieldBox}"
                                                 HorizontalAlignment="Left" Width="360" VerticalAlignment="Center"
                                                 Foreground="#222222"/>
                                        <TextBox Text="{Binding Quantity, Mode=TwoWay}" Style="{StaticResource FieldBox}"
                                                 HorizontalAlignment="Right" Width="180" TextAlignment="Right"
                                                 VerticalAlignment="Center" Foreground="#222222"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Method -->
                <TextBlock Text="Method" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Navy}" Margin="0,22,0,6"/>
                <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                    <TextBox Text="{Binding Method, Mode=TwoWay}" Style="{StaticResource FieldBox}"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                             Foreground="#333333"/>
                </Border>

                <!-- Storage -->
                <TextBlock Text="Storage" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource Navy}" Margin="0,20,0,6"/>
                <Border BorderBrush="#444444" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                    <TextBox Text="{Binding Storage, Mode=TwoWay}" Style="{StaticResource FieldBox}"
                             Foreground="#333333"/>
                </Border>

                <!-- only shown when the pop-up is opened with the edit pencil -->
                <Button x:Name="SaveButton" Content="SAVE" Style="{StaticResource NavyButton}" Width="130" Height="40"
                        FontSize="16" HorizontalAlignment="Right" Margin="0,18,0,0"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
