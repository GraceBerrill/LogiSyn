<!-- Adriaan -->
<UserControl x:Class="LogiSyn.Views.AdminOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Admin > Orders: search, status filter, orders table -->
    <Grid Margin="30,0,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="99"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="16.4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="59.3"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Orders" Style="{StaticResource PageTitle}"
                   VerticalAlignment="Top" Margin="0,15.3,0,0"/>
        <TextBlock x:Name="DateText" Grid.Row="0" Style="{StaticResource PageDate}"
                   VerticalAlignment="Top" Margin="4,64.7,0,0"/>

        <Button x:Name="LinkOrdersButton" Grid.Row="0" Content="Link To Orders"
                Style="{StaticResource OutlineButton}" Width="191.3"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,23,9,0"
                Click="LinkOrdersButton_Click"/>

        <!-- search + filter -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="583.3"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="268.7"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                     Tag="Search Orders" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="StatusFilter" Grid.Column="2" Style="{StaticResource FilterCombo}"
                      Margin="0,0,9,0" SelectionChanged="StatusFilter_SelectionChanged">
                <ComboBoxItem Content="All Statuses"/>
                <ComboBoxItem Content="Pending"/>
                <ComboBoxItem Content="Complete"/>
            </ComboBox>
        </Grid>

        <!-- table -->
        <ContentControl Grid.Row="3" Style="{StaticResource Card28}">
            <Grid>
                <!-- headings -->
                <Border Style="{StaticResource RowLine}" Height="81" VerticalAlignment="Top"
                        Margin="22,0,45,0">
                    <Grid Margin="5.3,36.6,0,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Order" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="1" Text="Customer" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="2" Text="Date" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="4" Text="Action" Style="{StaticResource HeadText}"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,81,45,20" Focusable="False">
                    <ItemsControl x:Name="OrderList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowLine}" Height="60" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OrderRow_Click">
                                    <Grid Margin="5.3,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource CellText}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Customer}" Style="{StaticResource CellText}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource CellText}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource CellText}"
                                                   Foreground="{Binding ListStatusBrush}"/>
                                        <!-- Adriaan - View Order Button -->
                                        <Button Grid.Column="4" Content="VIEW" Style="{StaticResource OutlineButton}"
                                                Height="32" Width="90" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Click="BtnViewOrder_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ContentControl>

        <Button x:Name="CreateOrderButton" Grid.Row="5" Content="Create New Order"
                Style="{StaticResource NavyButton}" Width="204" HorizontalAlignment="Right"
                Click="CreateOrderButton_Click"/>
    </Grid>
</UserControl>