<!-- Adriaan -->
<Page x:Class="LogiSyn.Views.UsersOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Orders"
      d:DesignHeight="800" d:DesignWidth="1100"
      Background="#F5F6FA"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Page.Resources>
        <!-- Clickable Order Row Card Style -->
        <Style x:Key="OrderCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="25,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#152238"/>
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="45,35,45,35">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Orders Container -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Orders" FontSize="36" FontWeight="Bold" Foreground="#152238"/>
            <TextBlock x:Name="TxtCurrentDate" Text="10/08/2026" FontSize="14" Foreground="#8A92A6" Margin="2,4,0,0"/>
        </StackPanel>

        <!-- 2. Outer White Container -->
        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="24" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1" 
                Padding="30,28">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OrdersItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource OrderCardButtonStyle}" Click="BtnOrderCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Order ID -->
                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding OrderId}" 
                                               FontSize="24" 
                                               FontWeight="Normal" 
                                               Foreground="#1B2136" 
                                               VerticalAlignment="Center"/>

                                    <!-- Customer -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Customer}" 
                                               FontSize="24" 
                                               FontWeight="Normal" 
                                               Foreground="#1B2136" 
                                               VerticalAlignment="Center"/>

                                    <!-- Status (Green for Completed, Red for Pending) -->
                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Status}" 
                                               FontSize="24" 
                                               FontWeight="Normal" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A83232"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Foreground" Value="#226E3B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                        <Setter Property="Foreground" Value="#226E3B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
