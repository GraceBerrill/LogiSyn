<UserControl x:Class="LogiSyn.Views.OrderSheetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogiSyn.Views">

    <!-- Admin > Orders > Link To Orders: summary on the left, raw material scaling on the right.
         (No sidebar on this page - the ShellWindow hides it.) -->
    <Grid Margin="14,0,28,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="27"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="59.3"/>
            <RowDefinition Height="27"/>
        </Grid.RowDefinitions>

        <Button x:Name="BackButton" Grid.Column="0" Grid.Row="1" Style="{StaticResource BackButton}"
                VerticalAlignment="Top" Click="BackButton_Click"/>

        <ScrollViewer Grid.Column="2" Grid.Row="1" Style="{StaticResource PaperPanel}">
            <local:SummaryPaper x:Name="SummaryDoc"/>
        </ScrollViewer>

        <ScrollViewer Grid.Column="4" Grid.Row="1" Style="{StaticResource PaperPanel}">
            <local:RawMaterialPaper x:Name="RawDoc"/>
        </ScrollViewer>

        <StackPanel Grid.Column="4" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddProductButton" Content="Add Product" Style="{StaticResource NavyButton}"
                    Width="204" Margin="0,0,25,0" Click="AddProductButton_Click"/>
            <Button x:Name="DoneButton" Content="DONE" Style="{StaticResource NavyButton}"
                    Width="204" Click="DoneButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>