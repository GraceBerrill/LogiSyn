<!-- Adriaan -->
<UserControl x:Class="LogiSyn.Views.OrderSheetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="#F5F6FA">

    <UserControl.Resources>
        <!-- Navy Action Button Style -->
        <Style x:Key="NavyActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#152238"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="28,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Back Circular Arrow Button -->
        <Style x:Key="CircleBackButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#152238"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21">
                            <TextBlock Text="&#xE72B;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root Grid hosting both the page content and the modal overlay -->
    <Grid>
        <!-- MAIN PAGE CONTENT -->
        <Grid Margin="30,30,40,30">
            <Grid.RowDefinitions>
                <!-- Back Button + Cards Grid -->
                <RowDefinition Height="*"/>
                <!-- Bottom Action Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Back Button Column -->
                    <ColumnDefinition Width="65"/>
                    <!-- Left Card: Production Items -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                    <!-- Right Card: Raw Material Scaling -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" 
                        VerticalAlignment="Top" 
                        Margin="0,5,0,0"
                        Style="{StaticResource CircleBackButton}"
                        Click="BtnBack_Click"/>

                <!-- LEFT CARD: Production Line Items -->
                <Border Grid.Column="1" 
                        Background="White" 
                        CornerRadius="10" 
                        BorderBrush="#152238" 
                        BorderThickness="10" 
                        Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtLeftOrderHeader" 
                                       Text="Spar Order #002" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1B2136"/>
                            <TextBlock x:Name="TxtLeftOrderDate" 
                                       Text="5 August 2026" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center" 
                                       FontSize="14" 
                                       Foreground="#718096"/>
                        </Grid>

                        <Separator Grid.Row="1" Background="#1B2136" Margin="0,0,0,12"/>

                        <!-- Scrollable Product List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsProductionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6,0,14">
                                            <!-- Product Title + Production Area -->
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#1B2136">
                                                <Run Text="{Binding ProductName, Mode=OneWay}"/>
                                                <Run Text="  •  " Foreground="#718096"/>
                                                <Run Text="{Binding ProductionLine, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Ingredients -->
                                            <TextBlock Text="Ingredients used:" FontSize="13" Foreground="#A0AEC0" Margin="0,5,0,2"/>
                                            <TextBlock Text="{Binding IngredientsSummary, Mode=OneWay}" FontSize="15" Foreground="#1B2136"/>

                                            <!-- Packaging -->
                                            <TextBlock Text="Packaging Used:" FontSize="13" Foreground="#A0AEC0" Margin="0,6,0,2"/>
                                            <TextBlock FontSize="15" Foreground="#1B2136">
                                                <Run Text="Pans: "/>
                                                <Run Text="{Binding Pans, Mode=OneWay}"/>
                                                <Run Text=",   Trolleys: "/>
                                                <Run Text="{Binding Trolleys, Mode=OneWay}"/>
                                            </TextBlock>

                                            <Separator Background="#CBD5E1" Margin="0,14,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- RIGHT CARD: Raw Material Scaling Totals -->
                <Border Grid.Column="3" 
                        Background="White" 
                        CornerRadius="10" 
                        BorderBrush="#152238" 
                        BorderThickness="10" 
                        Padding="22,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Header -->
                        <TextBlock Grid.Row="0" 
                                   x:Name="TxtRightOrderHeader" 
                                   Text="Spar Order #002" 
                                   FontSize="20" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1B2136"
                                   Margin="0,0,0,6"/>

                        <Grid Grid.Row="2" Margin="0,4,0,10">
                            <TextBlock Text="Raw Material Scaling" 
                                       FontSize="20" 
                                       FontWeight="SemiBold" 
                                       Foreground="#1B2136"/>
                            <TextBlock x:Name="TxtRightOrderDate" 
                                       Text="5 August 2026" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center" 
                                       FontSize="14" 
                                       Foreground="#718096"/>
                        </Grid>

                        <Separator Grid.Row="3" Background="#CBD5E1" Margin="0,0,0,14"/>

                        <!-- Raw Material Scaling Content -->
                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Total Amounts:" FontSize="19" FontWeight="SemiBold" Foreground="#1B2136" Margin="0,0,0,12"/>

                            <ItemsControl x:Name="ItemsScalingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="16" Foreground="#1B2136" Margin="0,4,0,4">
                                            <Run Text="{Binding Key, Mode=OneWay}"/>
                                            <Run Text=": "/>
                                            <Run Text="{Binding DisplayValue, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,20,0,0">
                <Button Content="Add Product" 
                        Style="{StaticResource NavyActionButtonStyle}" 
                        Margin="0,0,18,0"
                        Click="BtnAddProduct_Click"/>

                <Button Content="Save as Excel" 
                        Style="{StaticResource NavyActionButtonStyle}" 
                        Margin="0,0,18,0"
                        Click="BtnSaveExcel_Click"/>

                <Button Content="DONE" 
                        Style="{StaticResource NavyActionButtonStyle}" 
                        Width="160"
                        Click="BtnDone_Click"/>
            </StackPanel>
        </Grid>

        <!-- SUBMIT MODAL OVERLAY (DIMMED BACKGROUND + PRINT/EMAIL/SAVE EXCEL DIALOG) -->
        <Grid x:Name="SubmitModalOverlay" 
              Visibility="Collapsed" 
              Background="#66000000"
              MouseDown="SubmitModalOverlay_MouseDown">

            <Border Width="680" Height="220"
                    Background="White"
                    CornerRadius="24"
                    BorderBrush="#1B2136"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <Button Content="SAVE EXCEL" 
                            Width="190" Height="62"
                            Background="#152238" 
                            Foreground="White" 
                            FontSize="18" 
                            FontWeight="Bold"
                            Cursor="Hand"
                            Margin="0,0,18,0"
                            Click="BtnSaveExcel_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="PRINT (EXCEL)" 
                            Width="190" Height="62"
                            Background="#152238" 
                            Foreground="White" 
                            FontSize="18" 
                            FontWeight="Bold"
                            Cursor="Hand"
                            Margin="0,0,18,0"
                            Click="BtnPrint_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="EMAIL (EXCEL)" 
                            Width="190" Height="62"
                            Background="#152238" 
                            Foreground="White" 
                            FontSize="18" 
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnEmail_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>