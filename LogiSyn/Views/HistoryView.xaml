<UserControl x:Class="LogiSyn.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- History (Admin) / View History (Manager): completed orders with a VIEW link -->
    <Grid Margin="30,0,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="99"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="16.4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="History" Style="{StaticResource PageTitle}"
                   VerticalAlignment="Top" Margin="0,15.3,0,0"/>
        <TextBlock x:Name="DateText" Grid.Row="0" Style="{StaticResource PageDate}"
                   VerticalAlignment="Top" Margin="4,64.7,0,0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="583.3"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="268.7"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                     Tag="Search Orders" TextChanged="SearchBox_TextChanged"/>
            <ComboBox x:Name="DateFilter" Grid.Column="2" Style="{StaticResource FilterCombo}"
                      Margin="0,0,9,0" SelectionChanged="DateFilter_SelectionChanged">
                <ComboBoxItem Content="DATE"/>
                <ComboBoxItem Content="Newest first"/>
                <ComboBoxItem Content="Oldest first"/>
            </ComboBox>
        </Grid>

        <ContentControl Grid.Row="3" Style="{StaticResource Card28}">
            <Grid>
                <Border Style="{StaticResource RowLine}" Height="81" VerticalAlignment="Top"
                        Margin="22,0,45,0">
                    <Grid Margin="5.3,36.6,0,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="196"/>
                            <ColumnDefinition Width="275"/>
                            <ColumnDefinition Width="281"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Order" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="1" Text="Customer" Style="{StaticResource HeadText}"/>
                        <TextBlock x:Name="DateHeader" Grid.Column="2" Text="Date"
                                   Style="{StaticResource HeadText}"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,81,45,20" Focusable="False">
                    <ItemsControl x:Name="OrderList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowLine}" Height="60">
                                    <Grid Margin="5.3,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="196"/>
                                            <ColumnDefinition Width="275"/>
                                            <ColumnDefinition Width="281"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource CellText}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Customer}" Style="{StaticResource CellText}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource CellText}"/>
                                        <Button Grid.Column="3" Content="VIEW" Style="{StaticResource LinkButton}"
                                                Click="ViewButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>