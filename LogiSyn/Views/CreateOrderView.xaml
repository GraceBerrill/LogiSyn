<!-- Adriaan -->
<UserControl x:Class="LogiSyn.Views.CreateOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Root container hosting main content and loading overlay -->
    <Grid>
        <!-- Admin > Orders > Create New Order (upload box) -->
        <Grid Margin="30,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="99"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Create New Order" Style="{StaticResource PageTitle}"
                       VerticalAlignment="Top" Margin="0,15.3,0,0"/>
            <TextBlock x:Name="DateText" Grid.Row="0" Style="{StaticResource PageDate}"
                       VerticalAlignment="Top" Margin="4,64.7,0,0"/>

            <ContentControl Grid.Row="1" Style="{StaticResource Card28}" Margin="4,12.3,13.3,38">
                <Grid>
                    <!-- dashed drop area -->
                    <Grid x:Name="DropZone" Width="697.7" Height="351.3" VerticalAlignment="Top"
                          HorizontalAlignment="Center" Margin="0,154.7,0,0"
                          AllowDrop="True" Drop="DropZone_Drop">
                        <Rectangle Fill="#57D9D9D9" Stroke="#CC000000" StrokeThickness="1"
                                   StrokeDashArray="4 3" RadiusX="15" RadiusY="15"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Source="{StaticResource IconUpload}" Width="90" Height="90"/>
                            <TextBlock x:Name="UploadText" Text="Upload Order Here" FontSize="21.3"
                                       FontWeight="Light" Foreground="{StaticResource NavyMuted}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <Button x:Name="BrowseButton" Content="Browse Files" Width="191.3"
                                    Style="{StaticResource OutlineButton}" Margin="0,12,0,0"
                                    Click="BrowseButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="GoButton" Content="GO" Style="{StaticResource NavyButton}" Width="204"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,94,61"
                            Click="GoButton_Click"/>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- LOADING SPINNER OVERLAY -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#55000000">
            <Border Width="380" Height="210" Background="White" CornerRadius="20"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Direction="270"
                                      Opacity="0.25" Color="#122441"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Animated Circular Spinner -->
                    <Grid Width="54" Height="54" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Grid.RenderTransform>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=LoadingOverlay}" Value="Visible">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStory">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStory"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Background Track Ring -->
                        <Ellipse Width="54" Height="54" Stroke="#E2E7EE" StrokeThickness="5"/>

                        <!-- Sweeping Foreground Arc -->
                        <Path Stroke="{StaticResource Navy}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 27,2.5 A 24.5,24.5 0 1 1 2.5,27"/>
                    </Grid>

                    <TextBlock Text="Parsing Order File..." FontSize="20" FontWeight="Bold"
                               FontFamily="{StaticResource FontMS}" Foreground="{StaticResource Navy}"
                               HorizontalAlignment="Center" Margin="0,18,0,5"/>

                    <TextBlock Text="Please wait while ingredients are scaled..." FontSize="13.5"
                               FontFamily="{StaticResource FontMS}" Foreground="{StaticResource NavyMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>