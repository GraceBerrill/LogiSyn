<UserControl x:Class="LogiSyn.Views.PrintEmailModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="803" Height="256">

    <!-- The PRINT / EMAIL choice that opens when DONE is pressed on the order sheets page -->
    <Grid>
        <Border Background="White" BorderBrush="#99000000" BorderThickness="1" CornerRadius="40"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,12,0,0">
            <Button x:Name="PrintButton" Content="PRINT" Style="{StaticResource NavyButton}"
                    Width="324" Height="86" FontSize="33" Click="PrintButton_Click"/>
            <Button x:Name="EmailButton" Content="EMAIL" Style="{StaticResource NavyButton}"
                    Width="324" Height="86" FontSize="33" Margin="30,0,0,0" Click="EmailButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>