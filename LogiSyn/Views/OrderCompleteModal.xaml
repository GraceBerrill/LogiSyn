<!-- Adriaan -->
<UserControl x:Class="LogiSyn.Views.OrderCompletedModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="477" Height="591">

    <!-- The "order completed" pop-up: big navy circle with a tick and a DONE button -->
    <Grid>
        <Border Background="White" BorderBrush="#99000000" BorderThickness="1" CornerRadius="37"
                Effect="{StaticResource CardShadow}"/>

        <Ellipse Width="246" Height="246" Fill="{StaticResource Navy}"
                 VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,94,0,0"/>
        <Path Data="{StaticResource IconCheckGeometry}" Style="{StaticResource IconPath}"
              Stroke="White" StrokeThickness="1.6" Width="110" Height="110"
              VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,160,0,0"/>

        <Button x:Name="DoneButton" Content="DONE" Style="{StaticResource NavyButton}" Width="360"
                Height="61.3" FontSize="32" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,68" Click="DoneButton_Click"/>
    </Grid>
</UserControl>