<UserControl x:Class="LogiSyn.Views.EditUserModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LogiSyn.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="30" Width="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edit User"
                   Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Username" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox" Height="38" Padding="8,0"
                     VerticalContentAlignment="Center" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="New Password (leave blank to keep current)" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="38" Padding="8,0"
                         VerticalContentAlignment="Center" FontSize="16"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Access Level" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="AccessBox" Height="38" FontSize="16"
                      VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="Red"
                   TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="110" Height="40" Margin="0,0,10,0"
                    Click="Cancel_Click"/>
            <Button Content="Save Changes" Width="130" Height="40"
                    Click="Save_Click" Background="#2D6CDF" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>