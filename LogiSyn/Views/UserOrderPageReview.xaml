<Page x:Class="LogiSyn.Views.UserOrderPageReview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="User Order Review"
      d:DesignHeight="850" d:DesignWidth="1200"
      Background="#F5F6FA"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CircleBackButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#152238"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="21">
                            <TextBlock Text="&#xE72B;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- MAIN WORKSPACE -->
        <Grid Margin="30,25,35,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="55"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Back Button -->
            <Button Grid.Column="0" 
                    VerticalAlignment="Top" 
                    Margin="0,5,0,0"
                    Style="{StaticResource CircleBackButton}"
                    Click="BtnBack_Click"/>

            <!-- 2. Main Order Card (Thick Navy Border) -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="10" 
                    BorderBrush="#152238" 
                    BorderThickness="10" 
                    Padding="28,24" 
                    Margin="0,0,30,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Order Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtOrderDate" Text="5 August 2026" FontSize="15" Foreground="#718096" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtOrderTitle" Text="Spar Order #002" FontSize="22" FontWeight="SemiBold" Foreground="#152238"/>
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#152238" Margin="0,0,0,16"/>

                    <!-- Scrollable Product Tables -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsProductionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,28">
                                        <!-- PRODUCT HEADER TABLE -->
                                        <Border BorderBrush="#555555" BorderThickness="1" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.5*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="3*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26"/>
                                                    <RowDefinition Height="34"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Product" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Amount" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Production" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ProductName}" FontSize="15" FontWeight="SemiBold" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Amount}" FontSize="15" FontWeight="SemiBold" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ProductionLine}" FontSize="15" FontWeight="SemiBold" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#555555" BorderThickness="0,1,0,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- INGREDIENTS TABLE -->
                                        <Border BorderBrush="#555555" BorderThickness="1" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Height="26" Background="#F8FAFC">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Ingredients" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="Amount" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="Additional" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="Used" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Ingredients}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="34">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2.5*"/>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                    <ColumnDefinition Width="1.5*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding IngredientName}" FontSize="14" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayAmount}" FontSize="14" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                                <TextBlock Grid.Column="2" Text="{Binding DisplayAdditional}" FontSize="14" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                <Border Grid.Column="2" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                                <!-- Editable Amount Used -->
                                                                <TextBox Grid.Column="3" 
                                                                         Text="{Binding DisplayUsed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                         FontSize="14" 
                                                                         BorderThickness="0" 
                                                                         Background="Transparent" 
                                                                         VerticalContentAlignment="Center" 
                                                                         Padding="8,0"/>
                                                                <Border Grid.Column="3" BorderBrush="#555555" BorderThickness="0,1,0,0"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- PACKAGING TABLE -->
                                        <Border BorderBrush="#555555" BorderThickness="1" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Height="26" Background="#F8FAFC">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*"/>
                                                        <ColumnDefinition Width="2.0*"/>
                                                        <ColumnDefinition Width="2.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Packaging" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                    <TextBlock Grid.Column="1" Text="Amount" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="Used" FontSize="13" Foreground="#6B7280" Margin="8,4,0,0"/>
                                                </Grid>

                                                <!-- Pans -->
                                                <Grid Height="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*"/>
                                                        <ColumnDefinition Width="2.0*"/>
                                                        <ColumnDefinition Width="2.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Pans" FontSize="14" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                    <TextBlock Grid.Column="1" Text="{Binding Packaging.Pans}" FontSize="14" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                    <TextBox Grid.Column="2" Text="{Binding Packaging.PansUsed, Mode=TwoWay}" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"/>
                                                    <Border Grid.Column="2" BorderBrush="#555555" BorderThickness="0,1,0,0"/>
                                                </Grid>

                                                <!-- Trolleys -->
                                                <Grid Height="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*"/>
                                                        <ColumnDefinition Width="2.0*"/>
                                                        <ColumnDefinition Width="2.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Trolleys" FontSize="14" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <Border Grid.Column="0" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                    <TextBlock Grid.Column="1" Text="{Binding Packaging.Trolleys}" FontSize="14" Foreground="#152238" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <Border Grid.Column="1" BorderBrush="#555555" BorderThickness="0,1,1,0"/>

                                                    <TextBox Grid.Column="2" Text="{Binding Packaging.TrolleysUsed, Mode=TwoWay}" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="8,0"/>
                                                    <Border Grid.Column="2" BorderBrush="#555555" BorderThickness="0,1,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- NOTES BOX -->
                                        <TextBlock Text="Notes" FontSize="13" Foreground="#6B7280" Margin="2,0,0,4"/>
                                        <Border BorderBrush="#555555" BorderThickness="1" Height="70">
                                            <TextBox Text="{Binding Notes, Mode=TwoWay}" 
                                                     BorderThickness="0" 
                                                     Background="Transparent" 
                                                     AcceptsReturn="True" 
                                                     TextWrapping="Wrap" 
                                                     Padding="6"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 3. Right Action Buttons -->
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <Button Content="PRINT" 
                        Height="56"
                        Background="#152238" 
                        Foreground="White" 
                        FontSize="18" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="0,0,0,16"
                        Click="BtnPrint_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Mark As Completed" 
                        Height="56"
                        Background="#235E35" 
                        Foreground="White" 
                        FontSize="17" 
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="BtnMarkCompleted_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 4. MODAL OVERLAY: COMPLETION CHECKMARK (User - Orders3.png) -->
        <Grid x:Name="CompletedModalOverlay" 
              Visibility="Collapsed" 
              Background="#66000000">

            <Border Width="450" Height="450"
                    Background="White"
                    CornerRadius="30"
                    BorderBrush="#152238"
                    BorderThickness="1.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Large Navy Circle with White Checkmark -->
                    <Border Grid.Row="0" 
                            Width="190" Height="190" 
                            CornerRadius="95" 
                            Background="#152238" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   FontSize="85" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- DONE Confirmation Button -->
                    <Button Grid.Row="1" 
                            Content="DONE" 
                            Width="280" Height="58"
                            Background="#152238" 
                            Foreground="White" 
                            FontSize="22" 
                            FontWeight="Bold"
                            Cursor="Hand"
                            Margin="0,20,0,10"
                            Click="BtnModalDone_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
