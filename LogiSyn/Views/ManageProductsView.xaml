<UserControl x:Class="LogiSyn.Views.ManageProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Admin > Manage Products: search, storage filter, product table (VIEW / edit / delete) -->
    <Grid Margin="30,0,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="99"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="16.4"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Manage Products" Style="{StaticResource PageTitle}"
                   VerticalAlignment="Top" Margin="0,15.3,0,0"/>
        <TextBlock x:Name="DateText" Grid.Row="0" Style="{StaticResource PageDate}"
                   VerticalAlignment="Top" Margin="4,64.7,0,0"/>

        <!-- Top Control Bar: Search + Storage Filter + Add Product -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                     Tag="Search Products" TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="StorageFilter" Grid.Column="2" Style="{StaticResource FilterCombo}"
                      SelectionChanged="StorageFilter_SelectionChanged">
                <ComboBoxItem Content="Storage"/>
                <ComboBoxItem Content="Freezer"/>
                <ComboBoxItem Content="Fridge"/>
                <ComboBoxItem Content="Dry Store"/>
            </ComboBox>

            <!-- Added Add Product Button for Admin Role -->
            <Button x:Name="BtnAddProduct" Grid.Column="3" Style="{StaticResource PrimaryButton}"
                    Content="+ Add Product" Click="BtnAddProduct_Click" Grid.ColumnSpan="2" Margin="15,0,0,0"
                    Height="72" VerticalAlignment="Center" FontSize="21.3"/>
        </Grid>

        <!-- Product Table Container -->
        <ContentControl Grid.Row="3" Style="{StaticResource Card28}">
            <Grid>
                <!-- Headings -->
                <Border Style="{StaticResource RowLine}" Height="57.7" VerticalAlignment="Top"
                        Margin="22,0,22,0">
                    <Grid Margin="5.3,23.3,0,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="215"/>
                            <ColumnDefinition Width="141"/>
                            <ColumnDefinition Width="77"/>
                            <ColumnDefinition Width="106"/>
                            <ColumnDefinition Width="103"/>
                            <ColumnDefinition Width="82"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Product Name" Style="{StaticResource HeadTextSmall}"/>
                        <TextBlock Grid.Column="1" Text="Price Per Unit" Style="{StaticResource HeadTextSmall}"/>
                        <TextBlock Grid.Column="2" Text="Sell By" Style="{StaticResource HeadTextSmall}"/>
                        <TextBlock Grid.Column="3" Text="Best Before" Style="{StaticResource HeadTextSmall}"/>
                        <TextBlock Grid.Column="4" Text="Storage" Style="{StaticResource HeadTextSmall}"/>
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,57.7,22,20" Focusable="False">
                    <ItemsControl x:Name="ProductList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowLine}" Height="58">
                                    <Grid Margin="5.3,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="215"/>
                                            <ColumnDefinition Width="141"/>
                                            <ColumnDefinition Width="77"/>
                                            <ColumnDefinition Width="106"/>
                                            <ColumnDefinition Width="103"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellTextSmall}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Price}" Style="{StaticResource CellTextSmall}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SellBy}" Style="{StaticResource CellTextSmall}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding BestBefore}" Style="{StaticResource CellTextSmall}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Storage}" Style="{StaticResource CellTextSmall}"/>
                                        <Button Grid.Column="5" Content="VIEW" FontSize="21.3"
                                                Style="{StaticResource LinkButton}" Click="ViewButton_Click"/>
                                        <Button Grid.Column="6" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                HorizontalAlignment="Left" Click="EditButton_Click">
                                            <Path Data="{StaticResource IconEditGeometry}" Style="{StaticResource IconPath}"
                                                  Stroke="{StaticResource Navy}" Width="20" Height="20"/>
                                        </Button>
                                        <Button Grid.Column="7" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                HorizontalAlignment="Left" Click="DeleteButton_Click">
                                            <Path Data="{StaticResource IconTrashGeometry}" Style="{StaticResource IconPath}"
                                                  Stroke="#EF4444" Width="20" Height="20"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>