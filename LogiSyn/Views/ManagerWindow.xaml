<Window x:Class="LogiSyn.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiSyn.Views"
        mc:Ignorable="d"
        Title="Smart-X IoT Gateway"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#B0B0B0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="15,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="{TemplateBinding Tag}" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="18" 
                                           Margin="0,0,10,0" 
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1B2136">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,30,20,40">
                    <Border Width="35" Height="35" CornerRadius="17.5" Background="#3E4A61" Margin="0,0,10,0">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#B0B0B0" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
                    </Border>
                    <TextBlock Text="Admin" Foreground="#E0E0E0" VerticalAlignment="Center" FontSize="14"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Margin="20,0,20,0">

                    <Button Content="Dashboard" 
                            Tag="&#xE80F;" 
                            Style="{StaticResource MenuButtonStyle}"
                            Background="White" 
                            Foreground="#1B2136"/>
                    <Button Content="Orders" 
                            Tag="&#xE8A1;" 
                            Style="{StaticResource MenuButtonStyle}"/>
                    <Button Content="History" 
                            Tag="&#xE81C;" 
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Content="Manage Products" 
                            Tag="&#xE7B8;" 
                            Style="{StaticResource MenuButtonStyle}"/>

                </StackPanel>
                <Button Grid.Row="2" 
                        Margin="20,0,20,30" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        HorizontalContentAlignment="Left"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Log Out" Foreground="#E0E0E0" FontSize="14" Margin="0,0,5,0"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>
        <ContentControl x:Name="MainContent" Grid.Column="1"/>
    </Grid>
</Window>