<Window x:Class="LogiSyn.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogiSyn.Views"
        mc:Ignorable="d"
        Title="LogiSyn - Anderson's Bakery"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.Resources>
        <!-- Nav Button Style with complete click surface hit-testing -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,0"
                                SnapsToDevicePixels="True">
                            <!-- Background="Transparent" ensures the entire container receives click events -->
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- IsHitTestVisible="False" stops the icon from intercepting clicks -->
                                <TextBlock Grid.Column="0" 
                                           Text="{TemplateBinding Tag}" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="16" 
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>

                                <!-- IsHitTestVisible="False" stops the label text from intercepting clicks -->
                                <ContentPresenter Grid.Column="1" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"
                                                  IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2A334E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#354060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active button highlight variant for the currently selected page -->
        <Style x:Key="ActiveMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1B2136"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,0"
                                SnapsToDevicePixels="True">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="{TemplateBinding Tag}" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="16" 
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>

                                <ContentPresenter Grid.Column="1" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"
                                                  IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Panel -->
        <Border Grid.Column="0" Background="#1B2136">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- User Profile Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,25,20,35">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#3E4A61" Margin="0,0,12,0">
                        <TextBlock Text="&#xE77B;" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   Foreground="#E0E0E0" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center" 
                                   FontSize="16"
                                   IsHitTestVisible="False"/>
                    </Border>
                    <TextBlock Text="Admin" 
                               Foreground="#FFFFFF" 
                               VerticalAlignment="Center" 
                               FontSize="15" 
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Navigation Action Buttons -->
                <StackPanel Grid.Row="1" Margin="16,0,16,0">
                    <Button Content="Dashboard" 
                            Tag="&#xE80F;" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="NavDashboard_Click"/>

                    <!-- Adriaan - Orders Button -->
                    <Button Content="Orders" 
                            Tag="&#xE8A1;" 
                            Style="{StaticResource MenuButtonStyle}" 
                            Click="Button_Click_1"/>

                    <Button Content="History" 
                            Tag="&#xE81C;" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="NavHistory_Click"/>

                    <Button Content="Manage Products" 
                            Tag="&#xE7B8;" 
                            Style="{StaticResource MenuButtonStyle}"
                            Click="NavProducts_Click"/>
                </StackPanel>

                <!-- Logout Action -->
                <Button Grid.Row="2" 
                        Margin="20,0,20,25" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        HorizontalContentAlignment="Left"
                        Cursor="Hand"
                        Click="NavLogout_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" 
                                   FontFamily="Segoe MDL2 Assets" 
                                   Foreground="#A0AEC0" 
                                   FontSize="15" 
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Log Out" 
                                   Foreground="#A0AEC0" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Dynamic Content Hosting Area -->
        <Frame x:Name="MainFrame" 
               Grid.Column="1" 
               NavigationUIVisibility="Hidden"/>
        <!-- Adriaan - User Orders Button -->
        <Button x:Name="UserOrderTemp" Grid.Column="1" Content="Users Orders" HorizontalAlignment="Left" Margin="152,241,0,0" VerticalAlignment="Top" Click="UserOrderTemp_Click"/>
    </Grid>
</Window>