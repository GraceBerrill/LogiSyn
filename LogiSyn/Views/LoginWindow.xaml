<Window x:Class="LogiSyn.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - LogiSyn"
        Width="1016" Height="717"
        MinWidth="640" MinHeight="480"
        Background="#0F2340"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- Fonts (put the .ttf files in a Fonts folder, Build Action = Resource).
             Falls back to Segoe UI if they are missing. -->
        <FontFamily x:Key="LexendMega">Segoe UI</FontFamily>
        <FontFamily x:Key="MerriweatherSans">Segoe UI</FontFamily>

        <!-- Colours from the Figma file -->
        <SolidColorBrush x:Key="Navy" Color="#122441"/>
        <SolidColorBrush x:Key="BrandGrey" Color="#6B758C"/>
        <SolidColorBrush x:Key="FieldBorder" Color="#B5B5B5"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#4A000000"/>

        <!-- Borderless text entry that sits inside the rounded field border -->
        <Style x:Key="FieldBase" TargetType="Control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource LexendMega}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0,60,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldBase}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource FieldBase}"/>

        <!-- Field labels: "Username" / "Password" -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LexendMega}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
        </Style>

        <!-- Placeholder text drawn on top of the empty field -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LexendMega}"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource PlaceholderBrush}"/>
            <Setter Property="Margin" Value="17,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- The eye icon button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-shaped Log In button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Navy}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource MerriweatherSans}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Shadow lives on its own layer so it does not blur the text -->
                            <Border x:Name="Pill"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="33">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                      Direction="270" Opacity="0.25" Color="Black"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#1B3560"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#0B1830"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Viewbox keeps the card in proportion at any window size, like the Figma frame -->
    <Viewbox Stretch="Uniform" Margin="40">

        <!-- The white card: 565 x 531 (Figma 2261 x 2123 at 1/4 scale) -->
        <Border Width="565" Height="531"
                Background="White"
                CornerRadius="41">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="1"
                                  Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>

            <StackPanel Margin="25,41,25,0">

                <!-- ANDERSON'S BAKERY (letter-spaced) -->
                <ItemsControl x:Name="BrandLetters"
                              HorizontalAlignment="Center"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Margin="0,0,1.5,0"
                                       FontFamily="{StaticResource LexendMega}"
                                       FontWeight="SemiBold"
                                       FontSize="10"
                                       Foreground="{StaticResource BrandGrey}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Welcome Back -->
                <TextBlock Text="Welcome Back"
                           Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource LexendMega}"
                           FontWeight="SemiBold"
                           FontSize="32"
                           Foreground="{StaticResource Navy}"/>

                <!-- Username -->
                <TextBlock Text="Username" Style="{StaticResource FieldLabel}"
                           Margin="0,58,0,0"/>
                <Border Height="52" Margin="0,5,0,0"
                        Background="White"
                        BorderBrush="{StaticResource FieldBorder}"
                        BorderThickness="1"
                        CornerRadius="8.5">
                    <Grid>
                        <TextBox x:Name="UsernameBox"
                                 TextChanged="UsernameBox_TextChanged"/>
                        <TextBlock x:Name="UsernamePlaceholder"
                                   Text="Enter user name"
                                   Style="{StaticResource Placeholder}"/>
                        <Path Data="{StaticResource IconUserGeometry}" Style="{StaticResource IconPath}"
                              Stroke="{StaticResource Navy}"
                              Width="22" Height="22"
                              HorizontalAlignment="Right"
                              Margin="0,0,22,0"
                              IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Password -->
                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"
                           Margin="0,24,0,0"/>
                <Border Height="52" Margin="0,5,0,0"
                        Background="White"
                        BorderBrush="{StaticResource FieldBorder}"
                        BorderThickness="1"
                        CornerRadius="8.5">
                    <Grid>
                        <PasswordBox x:Name="PasswordBox"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <!-- Shown instead of the PasswordBox while the eye is toggled on -->
                        <TextBox x:Name="PasswordRevealBox"
                                 Visibility="Collapsed"
                                 TextChanged="PasswordRevealBox_TextChanged"/>
                        <TextBlock x:Name="PasswordPlaceholder"
                                   Text="Enter password"
                                   Style="{StaticResource Placeholder}"/>
                        <Button x:Name="ToggleReveal"
                                Style="{StaticResource IconButton}"
                                Width="60"
                                HorizontalAlignment="Right"
                                Click="ToggleReveal_Click">
                            <Grid Width="22" Height="22">
                                <Path x:Name="EyeIcon" Data="{StaticResource IconEyeGeometry}"
                                      Style="{StaticResource IconPath}" Stroke="{StaticResource Navy}"
                                      Visibility="Collapsed"/>
                                <Path x:Name="EyeOffIcon" Data="{StaticResource IconEyeOffGeometry}"
                                      Style="{StaticResource IconPath}" Stroke="{StaticResource Navy}"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Log In -->
                <Button x:Name="LoginButton"
                        Content="Log In"
                        Height="66"
                        Margin="0,43,0,0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click"/>

            </StackPanel>
        </Border>
    </Viewbox>
</Window>