 <Page x:Class="LogiSyn.Views.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="OrdersPage"
      d:DesignHeight="800" d:DesignWidth="940"
      Background="#F5F6FA">

    <Page.Resources>
        <Style x:Key="RoundedActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EAEBF0"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="15"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A92A6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>
    </Page.Resources>

    <Grid Margin="45,35,45,35">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Orders" FontSize="34" FontWeight="Bold" Foreground="#1B2136"/>
                <TextBlock x:Name="TxtCurrentDate" Text="10/08/2026" FontSize="13" Foreground="#8A92A6" Margin="2,4,0,0"/>
            </StackPanel>

            <Button Content="Link To Orders"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource RoundedActionButtonStyle}"
                    Background="White"
                    Foreground="#1B2136"
                    BorderBrush="#CFD6E4"
                    BorderThickness="1"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,25,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Search Bar -->
            <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="12" 
                    Height="48"
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="&#xE721;" 
                               FontFamily="Segoe MDL2 Assets" 
                               FontSize="16" 
                               Foreground="#8A92A6" 
                               VerticalAlignment="Center" 
                               Margin="0,0,12,0"/>

                    <TextBox Grid.Column="1" 
                             BorderThickness="0" 
                             Background="Transparent" 
                             FontSize="15" 
                             VerticalAlignment="Center" 
                             Foreground="#1B2136"
                             Text="Search Orders..."/>
                </Grid>
            </Border>

            <Border Grid.Column="2" 
                    Background="White" 
                    CornerRadius="12" 
                    Height="48"
                    BorderBrush="#E2E8F0" 
                    BorderThickness="1">
                <ComboBox BorderThickness="0" 
                          Background="Transparent" 
                          FontSize="15" 
                          FontWeight="SemiBold"
                          Foreground="#1B2136"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0"
                          Padding="15,0">
                    <ComboBoxItem Content="All Statuses"/>
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Complete"/>
                    <ComboBoxItem Content="Cancelled"/>
                </ComboBox>
            </Border>
        </Grid>

        <Border Grid.Row="2" 
                Background="White" 
                CornerRadius="18" 
                BorderBrush="#E2E8F0" 
                BorderThickness="1"
                Padding="25,15">
            <DataGrid x:Name="OrdersDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order" 
                                        Binding="{Binding OrderNumber}" 
                                        Width="1.2*" 
                                        FontWeight="SemiBold" 
                                        Foreground="#1B2136"/>

                    <DataGridTextColumn Header="Customer" 
                                        Binding="{Binding Customer}" 
                                        Width="2*" 
                                        Foreground="#1B2136"/>

                    <DataGridTextColumn Header="Date" 
                                        Binding="{Binding Date}" 
                                        Width="1.5*" 
                                        Foreground="#1B2136"/>

                    <DataGridTemplateColumn Header="Status" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" 
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CD964"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Foreground" Value="#E5989B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                    <Setter Property="Foreground" Value="#95A5A6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Button Grid.Row="3" 
                Content="Create New Order"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Style="{StaticResource RoundedActionButtonStyle}"
                Background="#1B2136"
                Foreground="White"/>
    </Grid>
</Page>