<Page x:Class="LogiSyn.Views.CreateOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="AddOrder"
      d:DesignHeight="800" d:DesignWidth="940"
      Background="#F5F6FA">

    <Page.Resources>
        <!-- Action Button Style (Pills) -->
        <Style x:Key="RoundedActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="45,35,45,35">
        <Grid.RowDefinitions>
            <!-- Title Header Row -->
            <RowDefinition Height="Auto"/>
            <!-- Upload Box & Action Button Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Create New Order" FontSize="34" FontWeight="Bold" Foreground="#1B2136"/>
            <TextBlock x:Name="TxtDate" FontSize="13" Foreground="#8A92A6" Margin="2,4,0,0"/>
        </StackPanel>

        <!-- 2. Main Container Card -->
        <Border Grid.Row="1"
                Margin="0,25,0,0"
                Background="White"
                CornerRadius="18"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dashed Upload Drop Zone -->
                <Border Grid.Row="0"
                        Background="#FAFBFC"
                        CornerRadius="12"
                        BorderBrush="#8A92A6"
                        BorderThickness="1.5"
                        AllowDrop="True"
                        Drop="Border_Drop"
                        DragOver="Border_DragOver">
                    <!-- Dashed border styling -->
                    <Border.Resources>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#95A5A6"/>
                        </Style>
                    </Border.Resources>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Cloud Upload Icon (Segoe MDL2 Assets) -->
                        <TextBlock Text="&#xEDE4;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="64"
                                   Foreground="#7F8C8D"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <TextBlock x:Name="TxtFileName"
                                   Text="Upload Order Here"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#7F8C8D"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- Browse Files Button -->
                        <Button Content="Browse Files"
                                Width="160"
                                Height="42"
                                Style="{StaticResource RoundedActionButtonStyle}"
                                Background="White"
                                Foreground="#1B2136"
                                BorderBrush="#CFD6E4"
                                BorderThickness="1"
                                FontSize="15"
                                Click="BtnBrowse_Click"/>
                    </StackPanel>
                </Border>

                <!-- 3. Bottom Right GO Button -->
                <Button Grid.Row="1"
                        Content="GO"
                        HorizontalAlignment="Right"
                        Margin="0,30,0,0"
                        Width="160"
                        Height="46"
                        FontSize="16"
                        Style="{StaticResource RoundedActionButtonStyle}"
                        Background="#1B2136"
                        Foreground="White"
                        Click="BtnGo_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>