<!-- Adriaan -->
<UserControl x:Class="LogiSyn.Views.UserOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- User > Orders: one clickable card per order -->
    <Grid Margin="51,0,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="102.3"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Orders" Style="{StaticResource PageTitle}"
                   VerticalAlignment="Top" Margin="0,19.7,0,0"/>
        <TextBlock x:Name="DateText" Grid.Row="0" Style="{StaticResource PageDate}"
                   VerticalAlignment="Top" Margin="2,73,0,0"/>

        <!-- Adriaan - Upload Excel Sheet Button -->
        <Button x:Name="BtnUploadExcel" Grid.Row="0"
                Content="Upload Excel Sheet"
                Style="{StaticResource NavyButton}"
                Width="200" Height="42"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,10,0"
                Cursor="Hand"
                Click="BtnUploadExcel_Click"/>

        <ContentControl Grid.Row="1" Style="{StaticResource Card28}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18,34.7,18,20" Focusable="False">
                <ItemsControl x:Name="OrderList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowCardButton}" Click="OrderRow_Click">
                                <Grid Margin="30,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="323"/>
                                        <ColumnDefinition Width="314"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="32" FontWeight="Light"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Customer}" FontSize="32" FontWeight="Light"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding UserStatusText}" FontSize="32" FontWeight="Light"
                                               Foreground="{Binding UserStatusBrush}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ContentControl>
    </Grid>
</UserControl>