<UserControl x:Class="LogiSyn.Views.ManageUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Manager > Manage Users -->
    <Grid Margin="30,0,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="84.7"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="15.6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Manage Users" Style="{StaticResource PageTitle}"
                   VerticalAlignment="Top" Margin="0,15.3,0,0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="583.3"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="277.7"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource SearchBox}"
                     Tag="Search Users" TextChanged="SearchBox_TextChanged"/>

            <Button x:Name="AddUserButton" Grid.Column="2" Style="{StaticResource OutlineButton}"
                    Height="72" FontSize="32" FontWeight="Regular" Click="AddUserButton_Click">
                <Grid Width="277">
                    <Image Source="{StaticResource IconAdd}" Width="42" Height="42"
                           HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <TextBlock Text="Add Users" Margin="82,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>

        <ContentControl Grid.Row="3" Style="{StaticResource Card16}" Margin="6,0,0,0">
            <Grid>
                <!-- headings -->
                <Border Style="{StaticResource RowLine}" Height="76" VerticalAlignment="Top"
                        Margin="6,0,22.4,0">
                    <Grid Margin="0,35.4,0,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136.6"/>
                            <ColumnDefinition Width="248.4"/>
                            <ColumnDefinition Width="194.3"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="User ID" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="2" Text="Access Level" Style="{StaticResource HeadText}"/>
                        <TextBlock Grid.Column="3" Text="Date Added" Style="{StaticResource HeadText}"/>
                    </Grid>
                </Border>

                <!-- rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6,76,22.4,20" Focusable="False">
                    <ItemsControl x:Name="UserList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowLine}" Height="57">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="136.6"/>
                                            <ColumnDefinition Width="248.4"/>
                                            <ColumnDefinition Width="194.3"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Style="{StaticResource CellText}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CellText}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Access}" Style="{StaticResource CellText}"
                                                   VerticalAlignment="Bottom" Margin="5,0,0,1"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DateAdded}" Style="{StaticResource CellText}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="40" Height="40"
                                                HorizontalAlignment="Left" Click="EditButton_Click">
                                            <Image Source="{StaticResource IconEdit}" Width="30" Height="30"/>
                                        </Button>
                                        <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="40" Height="40"
                                                HorizontalAlignment="Left" Click="DeleteButton_Click">
                                            <Image Source="{StaticResource IconTrash}" Width="30" Height="30"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>