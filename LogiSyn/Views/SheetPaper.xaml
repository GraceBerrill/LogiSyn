<UserControl x:Class="LogiSyn.Views.SheetPaper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogiSyn.Views"
             FontFamily="{StaticResource FontVarela}" Foreground="Black" Background="White">

    <!-- The production sheet (Figma "Order Sheet").
         DataContext = SheetData.  IsReadOnly = true shows the finished sheet (Manager),
         IsReadOnly = false lets the baker type into the "Used" boxes and the notes (User). -->
    <UserControl.Resources>

        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource PaperText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource PaperLabel}">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- the typeable "Used" boxes -->
        <Style x:Key="UsedBox" TargetType="TextBox" BasedOn="{StaticResource CellTextBox}">
            <Setter Property="IsReadOnly"
                    Value="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type local:SheetPaper}}}"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
        </Style>

        <Style x:Key="GridLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="16,50,15,24">

        <!-- date, title, COMPLETED -->
        <TextBlock Text="{Binding DateText}" FontSize="16" Margin="10.3,0,0,0"/>
        <Grid Margin="10.3,6,10,0">
            <TextBlock Text="{Binding Title}" FontSize="21.3"/>
            <TextBlock Text="COMPLETED" FontSize="21.3" HorizontalAlignment="Right"
                       Foreground="{StaticResource GreenAction}"
                       Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
        </Grid>
        <Border Height="1" Background="Black" Margin="5.3,8,7.7,16"/>

        <!-- one block per product -->
        <ItemsControl ItemsSource="{Binding Products}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Margin="0,0,0,8" Padding="6,6,6,10">
                        <StackPanel>

                            <!-- Product | Amount | Production -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="156.4"/>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Product" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Column="1" Text="Amount" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Column="2" Text="Production" Style="{StaticResource Label}"/>
                            </Grid>
                            <Border BorderBrush="Black" BorderThickness="1" Height="31">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155.4"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource GridLine}">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource GridLine}">
                                        <TextBlock Text="{Binding Amount}" Style="{StaticResource Cell}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Production}" Style="{StaticResource Cell}"/>
                                </Grid>
                            </Border>

                            <!-- Ingredients | Amount | Additional | Used -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="156.4"/>
                                    <ColumnDefinition Width="102"/>
                                    <ColumnDefinition Width="145.3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ingredients" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Column="1" Text="Amount" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Column="2" Text="Additional" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Column="3" Text="Used" Style="{StaticResource Label}"/>
                            </Grid>
                            <Border BorderBrush="Black" BorderThickness="0,0,0,1">
                                <ItemsControl ItemsSource="{Binding Ingredients}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="Black" BorderThickness="1,1,1,0" Height="31">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="155.4"/>
                                                        <ColumnDefinition Width="102"/>
                                                        <ColumnDefinition Width="145.3"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource GridLine}">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource GridLine}">
                                                        <TextBlock Text="{Binding Amount}" Style="{StaticResource Cell}"/>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource GridLine}">
                                                        <TextBlock Text="{Binding Additional}" Style="{StaticResource Cell}"/>
                                                    </Border>
                                                    <TextBox Grid.Column="3" Style="{StaticResource UsedBox}"
                                                             Text="{Binding Used, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Foreground="{Binding UsedBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Packaging | Amount | Used -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="156.4"/>
                                    <ColumnDefinition Width="91.6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Packaging" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Column="1" Text="Amount" Style="{StaticResource Label}"/>
                                <TextBlock Grid.Column="2" Text="Used" Style="{StaticResource Label}"/>
                            </Grid>
                            <Border BorderBrush="Black" BorderThickness="0,0,0,1">
                                <ItemsControl ItemsSource="{Binding Packaging}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="Black" BorderThickness="1,1,1,0" Height="31">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="155.4"/>
                                                        <ColumnDefinition Width="91.6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Style="{StaticResource GridLine}">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource GridLine}">
                                                        <TextBlock Text="{Binding Amount}" Style="{StaticResource Cell}"/>
                                                    </Border>
                                                    <TextBox Grid.Column="2" Style="{StaticResource UsedBox}"
                                                             Text="{Binding Used, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Foreground="{Binding UsedBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <!-- Notes -->
                            <TextBlock Text="Notes" Style="{StaticResource Label}" Margin="0,12,0,3"/>
                            <Border BorderBrush="Black" BorderThickness="1" Height="87.7">
                                <TextBox Style="{StaticResource UsedBox}" Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                         Padding="8,6,8,4" VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>