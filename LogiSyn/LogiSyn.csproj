    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<UserSecretsId>02cdf853-a885-4b1d-9977-3e6fb4e4347d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Views\AdminViews\**" />
